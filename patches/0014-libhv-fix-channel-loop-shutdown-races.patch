+    // @brief Run loop forever
+    void run() {
+        hloop_t* loop;
+        {
+            std::lock_guard<std::mutex> locker(mutex_);
+            if (loop_ == NULL || status() >= kRunning) return;
+            loop = loop_;
+            ThreadLocalStorage::set(ThreadLocalStorage::EVENT_LOOP, this);
+            setStatus(kRunning);
+        }
+        hloop_run(loop);
+        {
+            std::lock_guard<std::mutex> locker(mutex_);
+            setStatus(kStopping);
+            loop_ = NULL;
+        }
+        // Освобождение в потоке цикла, без mutex: возможны callbacks закрытия.
+        if (is_loop_owner) hloop_free(&loop);
+        setStatus(kStopped);
+    }
+
+    // stop thread-safe
+    void stop() {
+        hloop_t* loop;
+        {
+            std::lock_guard<std::mutex> locker(mutex_);
+            if (loop_ == NULL || status() >= kStopping) return;
+            loop = loop_;
+            if (status() >= kRunning) {
+                const bool paused = isPause();
+                setStatus(kStopping);
+                // На паузе очередь не обрабатывается.
+                if (paused) {
+                    hloop_stop(loop);
+                    return;
+                }
+                // Остановка после уже поставленных в очередь событий.
+                hevent_t ev = {};
+                ev.cb = [](hevent_t* e) { hloop_stop(hevent_loop(e)); };
+                hloop_post_event(loop, &ev);
+                return;
+            }
+            setStatus(kStopped);
+            loop_ = NULL;
+        }
+        if (is_loop_owner) hloop_free(&loop);
+    }
 
