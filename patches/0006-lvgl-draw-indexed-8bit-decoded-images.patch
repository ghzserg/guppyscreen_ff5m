+/*8-bit indexed source: 256 lv_color32_t palette entries, then one index byte per pixel*/
+static void indexed8_no_aa(const uint8_t * src, lv_coord_t src_w, lv_coord_t src_h, lv_coord_t src_stride,
+                           int32_t xs_ups, int32_t ys_ups, int32_t xs_step, int32_t ys_step,
+                           int32_t x_end, lv_color_t * cbuf, uint8_t * abuf)
+{
+    const lv_color32_t * palette = (const lv_color32_t *)src;
+    const uint8_t * idx = src + 256 * sizeof(lv_color32_t);
+    int32_t xs_ups_start = xs_ups;
+    int32_t ys_ups_start = ys_ups;
+
+    lv_coord_t x;
+    for(x = 0; x < x_end; x++) {
+        xs_ups = xs_ups_start + ((xs_step * x) >> 8);
+        ys_ups = ys_ups_start + ((ys_step * x) >> 8);
+
+        int32_t xs_int = xs_ups >> 8;
+        int32_t ys_int = ys_ups >> 8;
+        if(xs_int < 0 || xs_int >= src_w || ys_int < 0 || ys_int >= src_h) {
+            abuf[x] = 0;
+        }
+        else {
+            lv_color32_t c = palette[idx[ys_int * src_stride + xs_int]];
+            cbuf[x] = lv_color_make(c.ch.red, c.ch.green, c.ch.blue);
+            abuf[x] = c.ch.alpha;
+        }
+    }
+}
+
+/*Bilinear interpolation of the 4 nearest pixels, colors weighted by alpha*/
+static void indexed8_aa(const uint8_t * src, lv_coord_t src_w, lv_coord_t src_h, lv_coord_t src_stride,
+                        int32_t xs_ups, int32_t ys_ups, int32_t xs_step, int32_t ys_step,
+                        int32_t x_end, lv_color_t * cbuf, uint8_t * abuf)
+{
+    const lv_color32_t * palette = (const lv_color32_t *)src;
+    const uint8_t * idx = src + 256 * sizeof(lv_color32_t);
+    int32_t xs_ups_start = xs_ups;
+    int32_t ys_ups_start = ys_ups;
+
+    lv_coord_t x;
+    for(x = 0; x < x_end; x++) {
+        xs_ups = xs_ups_start + ((xs_step * x) >> 8);
+        ys_ups = ys_ups_start + ((ys_step * x) >> 8);
+
+        int32_t xs_int = xs_ups >> 8;
+        int32_t ys_int = ys_ups >> 8;
+        if(xs_int < 0 || xs_int >= src_w || ys_int < 0 || ys_int >= src_h) {
+            abuf[x] = 0;
+            continue;
+        }
+
+        /*Sample position relative to the pixel centers (xs_ups includes +0x80)*/
+        int32_t px = xs_ups - 0x80;
+        int32_t py = ys_ups - 0x80;
+        int32_t x0 = px >> 8;
+        int32_t y0 = py >> 8;
+        int32_t fx = px & 0xFF;
+        int32_t fy = py & 0xFF;
+        int32_t x1 = x0 + 1;
+        int32_t y1 = y0 + 1;
+        if(x0 < 0) x0 = 0;
+        if(y0 < 0) y0 = 0;
+        if(x1 >= src_w) x1 = src_w - 1;
+        if(y1 >= src_h) y1 = src_h - 1;
+
+        lv_color32_t c[4];
+        c[0] = palette[idx[y0 * src_stride + x0]];
+        c[1] = palette[idx[y0 * src_stride + x1]];
+        c[2] = palette[idx[y1 * src_stride + x0]];
+        c[3] = palette[idx[y1 * src_stride + x1]];
+        uint32_t w[4];
+        w[0] = (256 - fx) * (256 - fy);
+        w[1] = fx * (256 - fy);
+        w[2] = (256 - fx) * fy;
+        w[3] = fx * fy;
+
+        /*Alpha from the full weights (they sum to exactly 65536), so an opaque
+         *image stays opaque. Colors from the weights / 256 to stay in 32 bits.*/
+        uint32_t a_sum = 0, wa_sum = 0, r = 0, g = 0, b = 0;
+        int i;
+        for(i = 0; i < 4; i++) {
+            a_sum += w[i] * c[i].ch.alpha;                /*<= 65536 * 255*/
+            uint32_t wa = (w[i] >> 8) * c[i].ch.alpha;   /*<= 256 * 255*/
+            wa_sum += wa;
+            r += wa * c[i].ch.red;
+            g += wa * c[i].ch.green;
+            b += wa * c[i].ch.blue;
+        }
+        abuf[x] = (uint8_t)(a_sum >> 16);
+        if(wa_sum) {
+            cbuf[x] = lv_color_make(r / wa_sum, g / wa_sum, b / wa_sum);
+        }
+    }
+}
+
 static void argb_and_rgb_aa(const uint8_t * src, lv_coord_t src_w, lv_coord_t src_h, lv_coord_t src_stride,
                             int32_t xs_ups, int32_t ys_ups, int32_t xs_step, int32_t ys_step,
                             int32_t x_end, lv_color_t * cbuf, uint8_t * abuf, lv_img_cf_t cf)
