diff --git a/src/core/lv_refr.c b/src/core/lv_refr.c
index bfd2748..769f0be 100644
--- a/src/core/lv_refr.c
+++ b/src/core/lv_refr.c
@@ -177,7 +177,17 @@ void lv_obj_redraw(lv_draw_ctx_t * draw_ctx, lv_obj_t * obj)
         draw_ctx->clip_area = &clip_coords_for_children;
         uint32_t i;
         uint32_t child_cnt = lv_obj_get_child_cnt(obj);
-        for(i = 0; i < child_cnt; i++) {
+        /*Children under one that covers the whole clip area can't be seen:
+         *start from that one. (Otherwise a redraw wider than any one child,
+         *e.g. the whole screen, draws every child stacked in a container.)*/
+        uint32_t first = 0;
+        for(i = child_cnt; i > 0; i--) {
+            if(lv_refr_get_top_obj(&clip_coords_for_children, obj->spec_attr->children[i - 1]) != NULL) {
+                first = i - 1;
+                break;
+            }
+        }
+        for(i = first; i < child_cnt; i++) {
             lv_obj_t * child = obj->spec_attr->children[i];
             refr_obj(draw_ctx, child);
         }
