#
# Host (PC) build of guppyscreen plus its integration tests.
# Independent of the printer build: own compilers, own libhv/spdlog builds,
# everything under build-test/. Run from the repository root:
#
#   make test                     # build and run all tests (each in its own process)
#   make test TEST='*homing*'     # run matching test cases only
#   make test SANITIZE=1          # with AddressSanitizer + UBSan (separate build dir)
#   make -f tests/Makefile clean  # remove build-test/
#
# See docs/testing.md.

# Ignore the cross-build environment (docs/build-toolchain.md) if it is sourced.
override CROSS_COMPILE :=
override SYSROOT :=

HOST_CC  ?= gcc
HOST_CXX ?= g++

ifdef SANITIZE
OUT      := build-test/asan
SAN      := -fsanitize=address,undefined -fno-omit-frame-pointer
else
OUT      := build-test/default
SAN      :=
endif
DEPS_OUT := build-test/deps

LIBHV_SRC := $(DEPS_OUT)/libhv
LIBHV_A   := $(LIBHV_SRC)/lib/libhv.a
SPDLOG_A  := $(DEPS_OUT)/spdlog/libspdlog.a

# LVGL sources (the lvgl.mk parts used by the app; no demos or examples).
LVGL_DIR      := .
LVGL_DIR_NAME := lvgl
CSRCS :=
include lvgl/src/core/lv_core.mk
include lvgl/src/draw/lv_draw.mk
include lvgl/src/extra/lv_extra.mk
include lvgl/src/font/lv_font.mk
include lvgl/src/hal/lv_hal.mk
include lvgl/src/misc/lv_misc.mk
include lvgl/src/widgets/lv_widgets.mk
CSRCS := $(patsubst ./%,%,$(CSRCS))
CSRCS += $(wildcard assets/*.c) $(wildcard assets/material/*.c) $(wildcard lv_touch_calibration/*.c)

# The app without main.cpp (the tests provide main and the hardware).
APP_SRCS  := $(filter-out src/main.cpp src/kd_graphic_mode.cpp, $(wildcard src/*.cpp))
TEST_SRCS := $(wildcard tests/*.cpp) $(wildcard tests/harness/*.cpp)

OBJS := $(addprefix $(OUT)/obj/, $(CSRCS:.c=.o) $(APP_SRCS:.cpp=.o) $(TEST_SRCS:.cpp=.o))
BIN  := $(OUT)/guppy_tests

DEFINES := -DGUPPY_FF5M -DGUPPY_SMALL_SCREEN -D_GNU_SOURCE -DSPDLOG_COMPILED_LIB \
           -DTESTS_DIR=\"$(abspath tests)\" -DREPO_DIR=\"$(abspath .)\"
INC     := -I. -Isrc -Ilvgl -Ilv_touch_calibration -Ispdlog/include -I$(LIBHV_SRC)/include -Itests/harness -Itests/third_party
CFLAGS_COMMON := -O1 -g -MD -MP -w $(SAN) $(DEFINES) $(INC)

.PHONY: all run clean
all: $(BIN)

run: $(BIN)
	@sh tests/run_tests.sh $(BIN) '$(TEST)'

$(BIN): $(OBJS) $(LIBHV_A) $(SPDLOG_A)
	@mkdir -p $(dir $@)
	$(HOST_CXX) $(SAN) -o $@ $(OBJS) $(LIBHV_A) $(SPDLOG_A) -lpthread -lstdc++fs -lm

$(OUT)/obj/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "CC  $<"
	@$(HOST_CC) $(CFLAGS_COMMON) -c $< -o $@

# The headers of libhv are generated by its build, so app and test sources wait for it.
$(OUT)/obj/%.o: %.cpp | $(LIBHV_A)
	@mkdir -p $(dir $@)
	@echo "CXX $<"
	@$(HOST_CXX) -std=c++17 $(CFLAGS_COMMON) -c $< -o $@

# libhv builds inside its source tree, so build a private copy: the submodule
# itself holds the printer (ARM) build.
$(LIBHV_A):
	@rm -rf $(LIBHV_SRC) && mkdir -p $(DEPS_OUT)
	cp -a libhv $(LIBHV_SRC)
	$(MAKE) -C $(LIBHV_SRC) clean >/dev/null
	$(MAKE) -C $(LIBHV_SRC) -j$$(nproc) libhv CC=$(HOST_CC) CXX=$(HOST_CXX)

$(SPDLOG_A):
	cmake -S spdlog -B $(DEPS_OUT)/spdlog -DCMAKE_BUILD_TYPE=Release \
	      -DCMAKE_C_COMPILER=$(HOST_CC) -DCMAKE_CXX_COMPILER=$(HOST_CXX)
	$(MAKE) -C $(DEPS_OUT)/spdlog -j$$(nproc)

clean:
	rm -rf build-test

-include $(OBJS:.o=.d)
